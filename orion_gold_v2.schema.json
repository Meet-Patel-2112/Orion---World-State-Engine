{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orion-wse.local/schema/orion-gold-v2.schema.json",
  "title": "Orion Gold Annotation Schema v2",
  "description": "Gold annotations for one chapter of one work. Mentions, quotes, events and time expressions are spans in `text`. Facts and relationships are about entities, identified by `entity_key`, which is the same string in every chapter of a work, and each carries the evidence span that states it. `annotation.layers` declares how completely each layer was annotated, so a scorer counts a prediction as a false positive only where the layer is exhaustive. Conventions are in docs/gold_v2_guidelines.md. Rules JSON Schema cannot express (spans inside the text, end > start, mention text equal to its span, references that resolve) are checked by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_id",
    "work",
    "text",
    "annotation",
    "entities",
    "mentions",
    "quotes",
    "events",
    "facts",
    "relationships",
    "temporal_expressions",
    "temporal_relations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "doc_id": {
      "description": "`<work_id>/ch<NN>`, e.g. `pride_and_prejudice/ch01`.",
      "type": "string",
      "pattern": "^[a-z0-9_]+/ch[0-9]{2,3}$"
    },
    "work": {
      "$ref": "#/$defs/work"
    },
    "text": {
      "description": "The chapter text exactly as annotated. Every offset in this document is a character offset into it.",
      "type": "string",
      "minLength": 1
    },
    "annotation": {
      "$ref": "#/$defs/annotation"
    },
    "entities": {
      "description": "Every entity referenced in this chapter by a mention, quote, fact or relationship.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "mentions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mention"
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quote"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "temporal_expressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporalExpression"
      }
    },
    "temporal_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/temporalRelation"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "entityKey": {
      "description": "Lowercase snake_case name for an entity, stable across every chapter of a work, e.g. `elizabeth_bennet`.",
      "type": "string",
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "entityType": {
      "type": "string",
      "enum": [
        "character",
        "location",
        "object",
        "organization",
        "other"
      ]
    },
    "assertion": {
      "description": "How the text presents the statement: `asserted` (stated as true in the story), `negated` (stated as not true), `hypothetical` (wished, feared, supposed, dreamt, conditional or asked).",
      "type": "string",
      "enum": [
        "asserted",
        "negated",
        "hypothetical"
      ]
    },
    "review": {
      "description": "Where an item came from and whether a person has checked it. An item is gold only when `status` is `accepted` or `corrected`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "status"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "pdnc",
            "claude_draft",
            "human",
            "v1_import"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "accepted",
            "corrected"
          ]
        },
        "by": {
          "description": "Reviewer's name or initials.",
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "title",
        "author",
        "chapter_number",
        "source"
      ],
      "properties": {
        "work_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "chapter_number": {
          "type": "integer",
          "minimum": 1
        },
        "chapter_title": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "corpus",
            "license"
          ],
          "properties": {
            "corpus": {
              "type": "string",
              "enum": [
                "pdnc",
                "gutenberg",
                "original"
              ]
            },
            "url": {
              "type": "string"
            },
            "revision": {
              "description": "Commit or edition the text was taken from.",
              "type": "string"
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "text_offset": {
              "description": "Where this chapter's text starts in the source file, so source offsets can be traced.",
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "layerScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage"
      ],
      "properties": {
        "coverage": {
          "description": "`exhaustive`: every instance in the region is annotated, so anything else predicted there is wrong. `partial`: some are annotated, so only recall can be scored. `none`: not annotated, so the layer is not scored.",
          "type": "string",
          "enum": [
            "exhaustive",
            "partial",
            "none"
          ]
        },
        "region": {
          "description": "The part of `text` the coverage applies to. Omitted means the whole chapter.",
          "$ref": "#/$defs/span"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guidelines_version",
        "status",
        "layers"
      ],
      "properties": {
        "guidelines_version": {
          "type": "string",
          "const": "2.0"
        },
        "status": {
          "description": "`draft`: not reviewed. `in_review`: some items reviewed. `reviewed`: every item reviewed by one person. `adjudicated`: reviewed by two people, disagreements settled.",
          "type": "string",
          "enum": [
            "draft",
            "in_review",
            "reviewed",
            "adjudicated"
          ]
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mentions",
            "quotes",
            "events",
            "facts",
            "relationships",
            "temporal_expressions",
            "temporal_relations"
          ],
          "properties": {
            "mentions": {
              "description": "Covers mention spans and their entity links (coreference).",
              "$ref": "#/$defs/layerScope"
            },
            "quotes": {
              "$ref": "#/$defs/layerScope"
            },
            "events": {
              "$ref": "#/$defs/layerScope"
            },
            "facts": {
              "$ref": "#/$defs/layerScope"
            },
            "relationships": {
              "$ref": "#/$defs/layerScope"
            },
            "temporal_expressions": {
              "$ref": "#/$defs/layerScope"
            },
            "temporal_relations": {
              "$ref": "#/$defs/layerScope"
            }
          }
        },
        "annotators": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "enum": [
                  "drafter",
                  "reviewer",
                  "adjudicator"
                ]
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_key",
        "name",
        "type"
      ],
      "properties": {
        "entity_key": {
          "$ref": "#/$defs/entityKey"
        },
        "name": {
          "description": "The fullest proper name the work gives the entity, e.g. `Elizabeth Bennet`.",
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "aliases": {
          "description": "Other names and fixed descriptions the work uses for this entity anywhere, e.g. `Lizzy`, `Eliza`, `Miss Bennet`.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provisional": {
          "description": "True when the entity's identity is not settled yet: it may later prove to be another entity (\"the neighbourhood\" may be Meryton) and be merged into it. See guidelines §2.",
          "type": "boolean"
        },
        "external_ids": {
          "description": "Ids in the source corpus, e.g. {\"pdnc\": \"12\"}.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_id",
        "text",
        "type",
        "mention_kind",
        "entity_key",
        "start",
        "end"
      ],
      "properties": {
        "mention_id": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/entityType"
        },
        "mention_kind": {
          "type": "string",
          "enum": [
            "proper",
            "nominal",
            "pronominal"
          ]
        },
        "entity_key": {
          "description": "The entity this mention refers to; null for a mention of something not tracked as an entity (\"a man\" never seen again).",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "spans",
        "speaker_entity_key",
        "addressee_entity_keys",
        "quote_type"
      ],
      "properties": {
        "quote_id": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "spans": {
          "description": "The quoted words, without the quotation marks. More than one span when narration interrupts the quote (\"I think,\" said Jane, \"that ...\").",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "speaker_entity_key": {
          "description": "Who says it; null when the text does not let a careful reader tell.",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "addressee_entity_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityKey"
          }
        },
        "quote_type": {
          "description": "`explicit`: the speaker is named next to the quote. `anaphoric`: referred to by a pronoun or description (\"she said\"). `implicit`: no speech tag; known from context such as turn-taking.",
          "type": "string",
          "enum": [
            "explicit",
            "anaphoric",
            "implicit"
          ]
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "eventParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "mention_id"
      ],
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "agent",
            "patient",
            "target",
            "recipient",
            "location",
            "instrument",
            "participant"
          ]
        },
        "mention_id": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "type",
        "trigger",
        "start",
        "end",
        "participants",
        "assertion"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "ARRIVAL",
            "DEPARTURE",
            "TRAVEL",
            "MEETING",
            "CONVERSATION",
            "DISCOVERY",
            "ATTACK",
            "DEATH",
            "CONFLICT",
            "CREATION",
            "DESTRUCTION",
            "OTHER"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventParticipant"
          }
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "entity_key",
        "property",
        "value",
        "evidence",
        "assertion"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "pattern": "^F[0-9]+$"
        },
        "entity_key": {
          "$ref": "#/$defs/entityKey"
        },
        "property": {
          "type": "string",
          "enum": [
            "birth_place",
            "date_of_birth",
            "origin",
            "eye_color",
            "hair_color",
            "species",
            "age",
            "occupation",
            "title",
            "status",
            "location"
          ]
        },
        "value": {
          "description": "The value in the text's own words, as short as it can be without losing meaning (`one-and-twenty`, `clergyman`, `Netherfield Park`).",
          "type": "string",
          "minLength": 1
        },
        "value_span": {
          "description": "Where `value` occurs, when it occurs verbatim; inside `evidence`.",
          "$ref": "#/$defs/span"
        },
        "status_value": {
          "description": "Required when `property` is `status` (checked by the validator).",
          "type": "string",
          "enum": [
            "ALIVE",
            "DEAD",
            "MISSING",
            "INJURED",
            "UNCONSCIOUS",
            "OTHER"
          ]
        },
        "age_years": {
          "description": "The age as a whole number of years, when `property` is `age` and the text gives one (`one-and-twenty` -> 21).",
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "description": "The shortest stretch of text, usually one sentence, that states the fact.",
          "$ref": "#/$defs/span"
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "claimed_by": {
          "description": "The character whose speech, thought or letter contains the statement: the immediate claimant, not the original source of the information. Unset when the narrator states it. A claim records what a character says, not what is true in the story; characters can be mistaken, repeat rumours, or lie.",
          "$ref": "#/$defs/entityKey"
        },
        "source_entity_key": {
          "description": "The character the claimant names as the origin of the information, when the text names one: hearsay (\"Mrs. Long says that ...\" inside Mrs. Bennet's speech has claimed_by mrs_bennet, source mrs_long). Unset when the claimant speaks for themselves or the text names no source.",
          "$ref": "#/$defs/entityKey"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "subject_entity_key",
        "predicate",
        "object_entity_key",
        "evidence",
        "assertion"
      ],
      "properties": {
        "relationship_id": {
          "type": "string",
          "pattern": "^R[0-9]+$"
        },
        "subject_entity_key": {
          "$ref": "#/$defs/entityKey"
        },
        "predicate": {
          "description": "Directed predicates are written parent-first and employee-first (`A FATHER_OF B`, `A WORKS_FOR B`); there is no CHILD_OF. Symmetric predicates (FRIEND_OF, ENEMY_OF, SIBLING_OF, MARRIED_TO, ENGAGED_TO, ALLY_OF, KNOWS, RELATED_TO) may be written in either order and are scored as unordered.",
          "type": "string",
          "enum": [
            "FATHER_OF",
            "MOTHER_OF",
            "PARENT_OF",
            "SIBLING_OF",
            "MARRIED_TO",
            "ENGAGED_TO",
            "RELATED_TO",
            "FRIEND_OF",
            "ENEMY_OF",
            "ALLY_OF",
            "KNOWS",
            "WORKS_FOR",
            "MEMBER_OF",
            "OWNS"
          ]
        },
        "object_entity_key": {
          "$ref": "#/$defs/entityKey"
        },
        "evidence": {
          "$ref": "#/$defs/span"
        },
        "assertion": {
          "$ref": "#/$defs/assertion"
        },
        "claimed_by": {
          "description": "The character whose speech, thought or letter contains the statement: the immediate claimant, not the original source of the information. Unset when the narrator states it. A claim records what a character says, not what is true in the story; characters can be mistaken, repeat rumours, or lie.",
          "$ref": "#/$defs/entityKey"
        },
        "source_entity_key": {
          "description": "The character the claimant names as the origin of the information, when the text names one: hearsay (\"Mrs. Long says that ...\" inside Mrs. Bennet's speech has claimed_by mrs_bennet, source mrs_long). Unset when the claimant speaks for themselves or the text names no source.",
          "$ref": "#/$defs/entityKey"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "temporalExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_id",
        "text",
        "type",
        "start",
        "end"
      ],
      "properties": {
        "temporal_id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "absolute_time",
            "relative_time",
            "duration",
            "sequence_marker"
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "temporalRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_relation_id",
        "source_event_id",
        "relation",
        "target_event_id"
      ],
      "properties": {
        "temporal_relation_id": {
          "type": "string",
          "pattern": "^TR[0-9]+$"
        },
        "source_event_id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "relation": {
          "type": "string",
          "enum": [
            "BEFORE",
            "AFTER",
            "DURING"
          ]
        },
        "target_event_id": {
          "type": "string",
          "pattern": "^E[0-9]+$"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    }
  }
}
