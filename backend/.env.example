# Application Configuration
PROJECT_NAME="Orion World State Engine"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database & Cache
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/orion"
REDIS_URL="redis://localhost:6379/0"

# Celery Background Worker
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Extraction always runs ../extractor (its own venv, GPU; see app/pipeline/extractor.py).
# LLM Providers for chat (ollama, openai, mock)
LLM_PROVIDER="ollama"
OLLAMA_URL="http://127.0.0.1:11434/api/chat"
OLLAMA_MODEL="qwen3.5:9b"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Storage
STORAGE_DIR="./storage"

# CORS
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'
